# Required
API_KEYS=your-api-key-here,another-key-optional

# Stedi (real-time medical eligibility)
STEDI_API_KEY=your-stedi-api-key
PROVIDER_NPI=1234567890
PROVIDER_ORG=Your Practice Name

# pVerify (coverage discovery - optional)
PVERIFY_CLIENT_ID=
PVERIFY_CLIENT_SECRET=

# CORS (comma-separated origins, default: *)
ALLOWED_ORIGINS=https://yourdomain.com

# PHI masking in logs (default: true)
MASK_PHI_LOGS=true

# Demo mode - returns realistic sandbox data without live API keys
DEMO_MODE=false

# SQLite database path
DATABASE_URL=eligibility.db
